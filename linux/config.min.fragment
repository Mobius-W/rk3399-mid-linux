# RK3399 MID — 里程碑1 极简配置（基底 = allnoconfig）
# 思路：不从 defconfig 砍，而是从"什么都没有"开始只加需要的。
# 目标：Image <= 12 MiB，给 boot 分区（32 MiB）留足余量。

# ---- 平台 ----
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARM_PSCI_FW=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3399=y
CONFIG_ROCKCHIP_GRF=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_PM_DOMAINS=y

# ---- 内核基本机制（用户态要能跑 busybox）----
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_FUTEX=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_INOTIFY_USER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ---- 串口 UART2（debug console）----
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# ---- 存储：eMMC（arasan）+ 分区表 ----
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y

# ---- 网络：GMAC RGMII + RTL8211E ----
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_SYNOPSYS=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_MII=y

# ---- 供电 / 时钟树（RK808 + I2C）----
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_MFD_CORE=y
CONFIG_MFD_RK808=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_RK808=y
CONFIG_GPIOLIB=y

# ---- 一律不编（防 olddefconfig 复活）----
# CONFIG_MODULES is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_PCI is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_SECURITY is not set
# CONFIG_AUDIT is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_KALLSYMS is not set
# CONFIG_VT is not set
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_CRYPTO_USER_API is not set
